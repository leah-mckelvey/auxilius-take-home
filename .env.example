# Local root `npm run dev` reads this file before starting the API and web.
# Update DATABASE_URL to match your local PostgreSQL auth.
# Example for many macOS/Homebrew setups: postgres://YOUR_USERNAME@localhost:5432/auxilius_take_home
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auxilius_take_home
PORT=3000
VITE_API_PROXY_TARGET=http://localhost:3000

# Docker Compose also reads this file for the database container.
POSTGRES_DB=auxilius_take_home
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres